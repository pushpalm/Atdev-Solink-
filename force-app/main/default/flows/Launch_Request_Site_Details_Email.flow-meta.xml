<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Launches Salesforce Email Author with the Request Site Details template preselected and sets p3_lkid to the current record.</description>
    <environments>Default</environments>
    <formulas>
        <name>EmailAuthorUrl</name>
        <dataType>String</dataType>
        <expression>&quot;/_ui/core/email/author/EmailAuthor?p3_lkid=&quot; &amp; {!recordId} &amp; &quot;&amp;retURL=%2F&quot; &amp; {!recordId} &amp; &quot;&amp;template_id=00XG1000004o53pMAA&quot;</expression>
    </formulas>
    <interviewLabel>Launch Request Site Details Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Launch Request Site Details Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Launch_Email_Author</name>
        <label>Launch Email Author</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>email_author_launcher</name>
            <extensionName>c:flowEmailAuthorLauncher</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>targetUrl</name>
                <value>
                    <elementReference>EmailAuthorUrl</elementReference>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Launch_Email_Author</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
